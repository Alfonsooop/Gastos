# Configuración web de Firebase (Consola de Firebase → Configuración del proyecto → Tus apps → Web).
# No son datos secretos: la seguridad la dan las reglas de firestore.rules.
# Copiá este archivo como .env y completá los valores. Sin ellos, la app guarda todo en el navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Sólo desarrollo: usar el emulador local de Firestore (npx firebase emulators:start)
# VITE_FIRESTORE_EMULATOR_HOST=localhost:8080
